# spaCy model used for tokenisation (and for NER when NER_MODEL is empty)
SPACY_MODEL=en_core_web_sm
# HuggingFace NER model; leave empty to use spaCy NER only
NER_MODEL=dslim/bert-base-NER
INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# false = keyword heuristics only (no model download)
ENABLE_INJECTION_MODEL=true
# Optional local LLM for the rule generator and "Why?" explanations
OLLAMA_URL=http://localhost:11434
# Comma-separated preference list; the first pulled model is used
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=60
RULE_GENERATION_BUDGET_SECONDS=90
